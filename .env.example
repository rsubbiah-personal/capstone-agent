# LLM
OPENAI_API_KEY=
LLM_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

# Retrieval
FAISS_INDEX_PATH=knowledge/faiss_index
CHUNKS_PATH=knowledge/processed/chunks.json
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
TOP_K=5

# MCP
MCP_SERVER_HOST=127.0.0.1
MCP_SERVER_PORT=8765

# Monitoring
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=capstone-agent
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# Runtime
LOG_LEVEL=INFO
LOG_DIR=logs
